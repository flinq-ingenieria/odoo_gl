#. odoo-python
#: code:addons/project_timesheet_holidays/models/account_analytic.py:0
#, python-format
msgid ""
"You cannot create timesheets for a task that is linked to a time off type. "
"Please use the Time Off application to request new time off instead."
msgstr ""
"Non pode crear partes de horas para unha tarefa vinculada a un tipo de "
"ausencia. Recomendámoslle que use a aplicación Ausencias para solicitar "
"outra."

#. module: project_timesheet_holidays
#. odoo-python
#: code:addons/project_timesheet_holidays/models/account_analytic.py:0
#, python-format
msgid ""
"You cannot delete timesheets that are linked to time off requests. Please "
"cancel your time off request from the Time Off application instead."
msgstr ""
"Non pode eliminar partes de horas vinculados a solicitudes de ausencias. "
"Recomendámoslle que cancele a solicitude desde a aplicación Ausencias."

#. module: project_timesheet_holidays
#. odoo-python
#: code:addons/project_timesheet_holidays/models/account_analytic.py:0
#, python-format
msgid ""
"You cannot modify timesheets that are linked to time off requests. Please "
"use the Time Off application to modify your time off requests instead."
msgstr ""
"Non pode modificar partes de horas vinculados a solicitudes de ausencias. "
"Recomendámoslle que use a aplicación Ausencias para modificar as súas "
"solicitudes."
