msgid ""
"<br><br>\n"
"            Type <b>@username</b> to mention someone, and grab their attention.<br>\n"
"            Type <b>#channel</b> to mention a channel.<br>\n"
"            Type <b>/command</b> to execute a command.<br>"
msgstr ""
"<br><br>\n"
"            Escriba <b>@nombredeusuario</b> para mencionar a alguén e chamar a súa atención.<br>\n"
"            Escriba <b>#canle</b> para mencionar unha canle.<br>\n"
"            Escriba <b>/comando</b> para executar un comando.<br>"

